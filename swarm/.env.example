# ---------------------------------------------------------------------------
# SWARM local configuration. Copy to .env and fill in what you need.
# Never commit .env.
# ---------------------------------------------------------------------------

# API
SWARM_PORT=8787
SWARM_HOST=127.0.0.1
SWARM_DATA_DIR=./data
# Optional. When set, every /api request must send Authorization: Bearer <token>.
# When unset, the API is unauthenticated; keep SWARM_HOST bound to 127.0.0.1.
SWARM_API_TOKEN=

# Encryption key for integration credentials at rest (base64, 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SWARM_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Model provider
# provider: openai | openrouter | anthropic | openai-compatible
# Leave unset to run in "unconfigured" mode: SWARM starts and shows setup state,
# but goals cannot execute until a provider is configured.
# ---------------------------------------------------------------------------
SWARM_LLM_PROVIDER=
SWARM_LLM_API_KEY=
SWARM_LLM_MODEL=
# Optional base URL override (e.g. http://127.0.0.1:11434/v1 for a local model).
SWARM_LLM_BASE_URL=

# Per-run guardrails
SWARM_MAX_AGENTS=8
SWARM_MAX_TASKS=12
SWARM_MAX_TOOL_STEPS=6
SWARM_MAX_MODEL_CALLS=40
SWARM_MAX_TOKENS=120000
SWARM_RUN_TIMEOUT_MS=1800000

# ---------------------------------------------------------------------------
# Telegraph Protocol (testnet). Discovery is free. Purchases require approval.
# Read docs/TELEGRAPH_INTEGRATION.md before enabling payments.
# ---------------------------------------------------------------------------
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_EVM_PRIVATE_KEY=

# External extension execution is disabled by default. See docs/EXTENSION_PLATFORM.md.
SWARM_ENABLE_EXTERNAL_EXTENSIONS=false
SWARM_EXTENSION_DIR=./data/extensions

# Stdio MCP servers execute local processes. They are enabled for local-first use;
# set to false to allow only HTTP MCP servers. See docs/MCP_INTEGRATION.md.
SWARM_ALLOW_STDIO_MCP=true
